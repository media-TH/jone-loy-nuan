# สแกนโจร.online — environment variables
# Copy to .env.local for local development (never commit real values).
# On Vercel: Project Settings -> Environment Variables.
#
# Local preview without Supabase: leave the Supabase values empty. Public pages still render,
# the proxy skips the session refresh, and /mgmt-portal redirects to /login.
# Optional lines are commented out: uncomment only what you use (some code treats "" as a value).

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Canonical public origin (no trailing slash). Used for canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://xn--12co4czb5a2kj.online

# Google Search Console "HTML tag" verification token (the content="..." value only).
GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Supabase (Dashboard -> Project Settings -> API)
# ---------------------------------------------------------------------------

# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe key (sb_publishable_...). Preferred by the proxy and in development.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Optional legacy anon JWT key. Preferred by the browser/server clients in production when set.
# Leave the line commented out (not empty) when you only use the publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Secret key (sb_secret_...) or legacy service_role key. Bypasses RLS.
# Read only by utils/supabase/admin.ts (guarded by `import "server-only"`). Never prefix with NEXT_PUBLIC_.
SECRET_KEY=

# Optional. Name of the Edge Function that issues the anonymous quiz JWT (default: issue-anon-jwt).
# Keep commented out to use the default; an empty value is not treated as "unset".
# NEXT_PUBLIC_SUPABASE_ANON_TOKEN_FUNCTION=issue-anon-jwt

# ---------------------------------------------------------------------------
# Management portal
# ---------------------------------------------------------------------------

# Comma-separated admin emails allowed into /mgmt-portal, its Server Actions and /api/analytics/*.
# REQUIRED in production (NODE_ENV=production): empty = nobody is an admin (fail closed), because
# Supabase Auth sign-up is open by default, so "has an account" is not "is an admin".
# In development, empty = any signed-in (non-anonymous) Supabase Auth user.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------

# Bearer secret for GET /api/cron/keepalive (min. 16 characters; generate with `openssl rand -hex 32`).
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
# Use the same value for the GitHub Actions secret CRON_SECRET.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Content source
# ---------------------------------------------------------------------------

# Where quiz content comes from (lib/content/index.ts):
#   supabase    the database (the production default)
#   contentful  Contentful's Delivery API (needs the CONTENTFUL_* values below)
#   fixture     bundled SAMPLE content, for a local preview without any Supabase env
#   local / auto / empty: Supabase when NEXT_PUBLIC_SUPABASE_URL is set; otherwise, outside
#               production, the fixture
CONTENT_SOURCE=local

# Contentful (only when CONTENT_SOURCE=contentful). The delivery token is read-only but still
# server-only: never prefix it with NEXT_PUBLIC_.
CONTENTFUL_SPACE_ID=
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_ENVIRONMENT=master
# Optional Contentful locale codes for "th" / "en" (default: the space's default locale for "th",
# none for "en"). Keep commented out unless the space needs them.
# CONTENTFUL_LOCALE_TH=th
# CONTENTFUL_LOCALE_EN=en-US

# ---------------------------------------------------------------------------
# Set by the platform (do not set by hand)
# ---------------------------------------------------------------------------
# NODE_ENV                       development | production (Next.js)
# VERCEL_ENV                     production | preview | development (Vercel)
# VERCEL_PROJECT_PRODUCTION_URL  production host (Vercel)

# ---------------------------------------------------------------------------
# Not read by the app — configure elsewhere
# ---------------------------------------------------------------------------
# Supabase Edge Function issue-anon-jwt (Dashboard -> Edge Functions -> Secrets):
#   ANON_JWT_SECRET     project JWT secret used to sign anonymous quiz tokens
#   TOKEN_TTL_SECONDS   token lifetime in seconds (default 86400, clamped to 300–86400)
# GitHub Actions secrets for .github/workflows/supabase-keepalive.yml:
#   KEEPALIVE_URL             https://<your-domain>/api/cron/keepalive
#   CRON_SECRET               same value as above
#   SUPABASE_URL              optional, direct database ping
#   SUPABASE_SERVICE_ROLE_KEY optional, direct database ping
